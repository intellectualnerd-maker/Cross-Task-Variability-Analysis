# Root-level ignores for Cross-Task Variability Analysis

# Project-specific logs
BUG_REPORTS.yaml

# Python (Source/Compiled/Caches)
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
*.pyd
*.pkl

# Environments & Packaging
.env
.venv/
env/
venv/
build/
dist/
*.egg-info/
.eggs/
lib/
lib64/
wheels/
share/python-wheels/

# Jupyter Notebooks
.ipynb_checkpoints

# IDEs and Editors
.vscode/
.history/
*.code-workspace
.cursorignore
.cursorindexingignore
.idea/
.spyderproject
.spyproject
.ropeproject

# OS Files
Thumbs.db
Desktop.ini
.DS_Store

# Data & Binary files (Aggressive ignore - usually kept local)
*.bin
*.csv
*.CSV
*.json
*.sqlite3

# Test/Coverage
.coverage
.coverage.*
.pytest_cache/
.tox/
.nox/
htmlcov/
